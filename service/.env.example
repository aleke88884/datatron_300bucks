# Ключ API (заголовок X-API-Key). Обязателен. Сгенерировать: python3 -c 'import secrets;print(secrets.token_hex(16))'
API_KEY=change-me
# Лимит размера загружаемого файла, МБ
MAX_UPLOAD_MB=300
# Жёсткий лимит обработки одного видео, с, ОТ МОМЕНТА POST (ТЗ: 5 минут; оставляем запас).
# По его достижении задание всё равно получает ответ (done, meta.degraded=true), а не failed.
JOB_TIMEOUT_SEC=240
# Мягкий дедлайн, с от POST: к нему пайплайн сам снижает частоту кадров/отключает VLM. Пусто = 70 % от JOB_TIMEOUT_SEC.
# SOFT_DEADLINE_SEC=168
# Число параллельных процессов анализа; пусто = авто (2 при >= 4 ядрах)
# WORKERS=2
# Хранить ли загруженные видео после анализа (по ТЗ тестовые видео хранить нельзя — оставляем false)
KEEP_UPLOADS=false
# Допустимые расширения
# ALLOWED_EXTENSIONS=.mov,.mp4,.m4v,.avi,.mkv,.webm,.mpg,.mpeg,.3gp  (по умолчанию; файл без расширения принимается как .mov)
LOG_LEVEL=INFO
