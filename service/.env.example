# Ключ API (заголовок X-API-Key). Обязателен. С заглушкой change-me сервис НЕ стартует (понятное сообщение в журнале).
# Сгенерировать и записать в .env: python3 deploy/gen_api_key.py
API_KEY=change-me
# Веб-интерфейс без ввода ключа (страница / выдаёт HttpOnly-cookie); вызовы API без cookie по-прежнему требуют X-API-Key.
# UI_OPEN=true
# Лимит размера загружаемого файла, МБ
MAX_UPLOAD_MB=300
# Жёсткий лимит обработки одного видео, с, ОТ МОМЕНТА POST, включая ожидание в очереди (ТЗ: 5 минут; запас на опрос).
# По его достижении задание всё равно получает ответ (done, meta.degraded=true, meta.degraded_reason), а не failed.
# Сервис в любом случае не тянет дедлайн дальше 285 с от POST.
JOB_TIMEOUT_SEC=270
# Мягкий дедлайн, с от POST: к нему пайплайн сам снижает частоту кадров/отключает VLM. Пусто = 80 % от JOB_TIMEOUT_SEC.
# SOFT_DEADLINE_SEC=216
# Очередь: короткие записи первыми; задание, прождавшее дольше этого, идёт раньше новых
# QUEUE_AGING_SEC=45
# Число параллельных процессов анализа; пусто = авто (1 процесс со всеми ядрами; 2 при >= 12 ядрах).
# Замер M3 8 ГБ: 1×8 потоков — 165 с на Х-14, 2×4 — по 294 с параллельно (пропускная способность та же, ответ позже).
# WORKERS=1
# Хранить ли загруженные видео после анализа (по ТЗ тестовые видео хранить нельзя — оставляем false)
KEEP_UPLOADS=false
# Допустимые расширения
# ALLOWED_EXTENSIONS=.mov,.mp4,.m4v,.avi,.mkv,.webm,.mpg,.mpeg,.3gp  (по умолчанию; файл без расширения принимается как .mov)
LOG_LEVEL=INFO
# Необязательная локальная VLM (README, раздел «VLM-слой» и «Страховочная сетка»). На CPU/Apple Silicon — llama.cpp:
# VLM_ENABLED=1
# VLM_BACKEND=llamacpp
# SAFETY_NET=auto
