# Ключ API (заголовок X-API-Key). Обязателен. Сгенерировать: python3 -c 'import secrets;print(secrets.token_hex(16))'
API_KEY=change-me
# Лимит размера загружаемого файла, МБ
MAX_UPLOAD_MB=300
# Таймаут обработки одного видео, с (ТЗ: 5 минут; оставляем запас)
JOB_TIMEOUT_SEC=240
# Хранить ли загруженные видео после анализа (по ТЗ тестовые видео хранить нельзя — оставляем false)
KEEP_UPLOADS=false
# Допустимые расширения
ALLOWED_EXTENSIONS=.mov,.mp4
LOG_LEVEL=INFO
